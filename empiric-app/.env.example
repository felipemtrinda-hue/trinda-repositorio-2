# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Somente servidor (NUNCA prefixar com NEXT_PUBLIC_). Usada para criar usuários,
# gerar links assinados e rodar a rotina diária.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública do app (links de e-mail de convite / recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protege /api/cron/* (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=troque-por-um-valor-aleatorio

# Integrações (Etapa 6) — deixe vazio até contratar os fornecedores.
# Sem estas chaves, as entregas ficam como "skipped_not_configured" e o painel avisa.
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
